# Copy to `.env` and fill in for local “Ask for clarity” (dev server only; key stays on the machine, not in the bundle).
OPENAI_API_KEY=

# Optional: override model for clarity (default gpt-4o-mini)
# ILP_OPENAI_MODEL=gpt-4o-mini

# Optional: deployed builds — HTTPS endpoint that accepts POST JSON { question, context } and returns { answer }
# VITE_CLARITY_API_URL=https://your-worker.example.com/clarity
